{
  "expo": {
    "name": "PPK Mobile",
    "slug": "ppk-mobile",
    "scheme": ["ppkmobile", "com.muhffikkris.ppkmobile"],
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#161522",
      "barStyle": "light-content"
    },
    "android": {
      "package": "com.muhffikkris.ppkmobile",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCkXvzw4zBPPza-98nIH-M0MIIxaT01wPY"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#F4F2F9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9723b307-1ce7-46f3-8519-7a183468dd98"
      }
    },
    "owner": "elvish20s-team",
    "experiments": {
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9723b307-1ce7-46f3-8519-7a183468dd98"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan PPK Mobile menggunakan lokasi saat presensi dan saat menampilkan posisi Anda di peta."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan PPK Mobile mengakses kamera untuk memindai barcode presensi."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F2F9"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ]
  }
}
