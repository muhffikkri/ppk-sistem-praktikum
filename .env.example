# Firebase Web/JS SDK Configuration (Expo public env vars)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth (untuk login Google native via expo-auth-session)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Seeder (npm run seed) — tidak ikut ke bundle aplikasi karena bukan EXPO_PUBLIC_
# Path file service account dari Firebase Console → Project settings → Service accounts
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Opsional: password akun demo di Firebase Auth (minimal 6 karakter)
SEED_DEMO_PASSWORD=
