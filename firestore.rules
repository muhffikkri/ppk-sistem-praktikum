rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == role;
    }

    function isAssistant() {
      return hasRole('assistant');
    }

    function isStudent() {
      return hasRole('student');
    }

    function isAslab() {
      return hasRole('aslab');
    }

    function isLabManagerForCourse(data) {
      return isAslab()
        && (
          !('courseId' in data)
          || data.courseId == null
          || data.courseId == ''
          || (
            'managedCourseIds' in userDoc().data
            && userDoc().data.managedCourseIds is list
            && data.courseId in userDoc().data.managedCourseIds
          )
        );
    }

    function sessionData(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    function validTransition(from, to) {
      return from == to
        || (from == 'scheduled' && to == 'open')
        || (from == 'open' && to == 'closed');
    }

    // 1. Profil Pengguna
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAssistant() || isAslab());

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['student', 'assistant']
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0;

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.get('managedCourseIds', []) == resource.data.get('managedCourseIds', []);

      allow delete: if false;
    }

    match /users/{uid}/push_tokens/{installationId} {
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 200
        && request.resource.data.token.matches('^(Expo|Exponent)PushToken\\[[A-Za-z0-9_-]+\\]$')
        && request.resource.data.platform in ['android', 'ios']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Inbox notifikasi: hanya ditulis server (Admin SDK); pemilik hanya boleh
    // membaca dan menandai sudah dibaca.
    match /users/{uid}/notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt is string
        && request.resource.data.readAt.size() <= 40;
      allow create, delete: if false;
    }

    // 2. Kelas & Peserta
    match /classes/{classId} {
      allow read: if (isAssistant() && request.auth.uid in resource.data.assistantIds)
        || (isStudent() && request.auth.uid in resource.data.participantIds)
        || (isAslab() && (
          !('courseId' in resource.data)
          || resource.data.courseId == null
          || (
            'managedCourseIds' in userDoc().data
            && userDoc().data.managedCourseIds is list
            && resource.data.courseId in userDoc().data.managedCourseIds
          )
        ));

      allow create: if isAssistant()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.assistantIds
        && request.resource.data.courseName is string
        && request.resource.data.courseName.size() > 0
        && request.resource.data.groupName is string
        && request.resource.data.groupName.size() > 0;

      allow update: if (isAssistant()
        && request.auth.uid in resource.data.assistantIds
        && request.auth.uid in request.resource.data.assistantIds
        && request.resource.data.createdBy == resource.data.createdBy)
        || (isAslab()
          && request.resource.data.createdBy == resource.data.createdBy);

      allow delete: if isAssistant() && request.auth.uid in resource.data.assistantIds;
    }

    // 3. Jadwal & Sesi Praktikum
    match /sessions/{sessionId} {
      allow read: if (isAssistant() && request.auth.uid in resource.data.assistantIds)
        || (isStudent() && request.auth.uid in resource.data.participantIds)
        || isAslab();

      allow create: if isAssistant()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'scheduled'
        && request.resource.data.openedAt == null
        && request.resource.data.closedAt == null
        && request.resource.data.startsAt is string
        && request.resource.data.endsAt is string
        && request.auth.uid in request.resource.data.assistantIds;

      allow update: if (isAssistant()
        && request.auth.uid in resource.data.assistantIds
        && request.resource.data.createdBy == resource.data.createdBy
        && validTransition(resource.data.status, request.resource.data.status))
        || (isAslab()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.startsAt == resource.data.startsAt
          && request.resource.data.endsAt == resource.data.endsAt);

      allow delete: if isAssistant() && request.auth.uid in resource.data.assistantIds;
    }

    // 3b. Master Laboratorium — acuan geofence presensi & peta
    function validLab(data) {
      return data.name is string && data.name.size() > 0
        && data.building is string && data.building.size() > 0
        && data.location.latitude is number
        && data.location.latitude >= -90 && data.location.latitude <= 90
        && data.location.longitude is number
        && data.location.longitude >= -180 && data.location.longitude <= 180
        && data.radiusMeters is int
        && data.radiusMeters >= 10 && data.radiusMeters <= 500
        && data.isActive is bool;
    }

    match /labs/{labId} {
      allow read: if isSignedIn();

      allow create: if isLabManagerForCourse(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && validLab(request.resource.data);

      allow update: if isLabManagerForCourse(resource.data)
        && isLabManagerForCourse(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && validLab(request.resource.data);

      allow delete: if false;
    }

    // Geofence presensi: sesi wajib terhubung ke labs/{labId}, perangkat wajib
    // mengirim koordinat + jarak, dan keduanya harus konsisten dengan radius lab.
    function withinLabGeofence(data, session) {
      return session.labId is string
        && exists(/databases/$(database)/documents/labs/$(session.labId))
        && labWithinRadius(
          data,
          get(/databases/$(database)/documents/labs/$(session.labId)).data
        );
    }

    function labWithinRadius(data, lab) {
      return data.deviceLocation.keys().hasOnly(['latitude', 'longitude', 'accuracyMeters'])
        && data.deviceLocation.latitude is number
        && data.deviceLocation.longitude is number
        && (data.deviceLocation.get('accuracyMeters', null) == null
          || data.deviceLocation.accuracyMeters <= 100)
        && data.distanceMeters is number
        && data.distanceMeters >= 0
        && data.distanceMeters <= lab.radiusMeters
        && math.abs(data.deviceLocation.latitude - lab.location.latitude)
          <= (lab.radiusMeters + 1) / 111320.0
        && math.abs(data.deviceLocation.longitude - lab.location.longitude)
          <= (lab.radiusMeters + 1) / 110000.0;
    }

    // 4. Presensi Terintegrasi (ID deterministik: {sessionId}_{studentId})
    match /attendance/{attendanceId} {
      // get dokumen milik sendiri boleh walau belum ada (cek duplikasi setelah permission-denied)
      allow get: if isAssistant()
        || isAslab()
        || (isStudent() && attendanceId.matches('^.+_' + request.auth.uid + '$'));

      allow list: if isAssistant()
        || isAslab()
        || (isStudent() && resource.data.studentId == request.auth.uid);

      allow create: if isStudent()
        && request.resource.data.keys().hasOnly([
          'id', 'sessionId', 'classId', 'studentId', 'studentName',
          'checkedInAt', 'deviceLocation', 'distanceMeters'
        ])
        && request.resource.data.studentId == request.auth.uid
        && attendanceId == (request.resource.data.sessionId + '_' + request.auth.uid)
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
        && sessionData(request.resource.data.sessionId).status == 'open'
        && request.auth.uid in sessionData(request.resource.data.sessionId).participantIds
        && request.resource.data.checkedInAt is string
        && request.resource.data.studentName is string
        && withinLabGeofence(
          request.resource.data,
          sessionData(request.resource.data.sessionId)
        );

      allow update, delete: if false;
    }

    // 5. Pengajuan Izin & Pemeriksaan Asisten
    match /leave_requests/{leaveId} {
      allow read: if isAssistant()
        || isAslab()
        || (isStudent() && resource.data.studentId == request.auth.uid);

      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
        && request.auth.uid in get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.participantIds;

      allow update: if isAssistant()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.aiPrediction == resource.data.aiPrediction
        && request.auth.uid in sessionData(resource.data.sessionId).assistantIds;

      allow delete: if false;
    }
  }
}