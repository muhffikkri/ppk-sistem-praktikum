rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == role;
    }

    function isAssistant() {
      return hasRole('assistant') || hasRole('lab_assistant');
    }

    function isStudent() {
      return hasRole('student');
    }

    function validNim(data) {
      return !('nim' in data) || (data.nim is string && data.nim.matches('^[A-Z0-9]{6,20}$'));
    }

    function validStudentNim(data) {
      return !('studentNim' in data)
        || (data.studentNim is string && data.studentNim.matches('^[A-Z0-9]{6,20}$'));
    }

    function hasAssistantInvite() {
      return isSignedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/assistant_invites/$(request.auth.token.email.lower()));
    }

    function sessionData(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    // Edit hanya untuk sesi scheduled: lab/class tidak boleh berubah saat open.
    function validSessionEdit() {
      return resource.data.status == 'scheduled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'classId', 'courseName', 'groupName', 'participantIds', 'assistantIds',
          'title', 'lab', 'labId', 'startsAt', 'endsAt', 'startsAtMs', 'endsAtMs',
          'updatedAt'
        ])
        && request.resource.data.startsAt is string
        && request.resource.data.endsAt is string
        && request.resource.data.startsAtMs is int
        && request.resource.data.endsAtMs is int
        && request.resource.data.endsAtMs > request.resource.data.startsAtMs
        && exists(/databases/$(database)/documents/classes/$(request.resource.data.classId))
        && request.auth.uid in get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.assistantIds;
    }

    // Transisi status hanya boleh mengubah field yang relevan.
    // Membuka sesi sengaja dilarang dari klien: rules tidak bisa melakukan
    // query sesi open lain untuk asisten yang sama. Gunakan callable openSession
    // yang berjalan di Admin SDK dan memvalidasi konflik di dalam transaction.
    function validStatusPatch() {
      return (
        resource.data.status == 'open'
        && request.resource.data.status == 'closed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'closedAt'
        ])
      ) || (
        resource.data.status == 'scheduled'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelledAt'
        ])
      );
    }

    // Izin hanya sampai batas waktu sesi; sesi closed tidak menerima izin.
    function withinLeaveWindow(data) {
      return data.endsAtMs is int
        && request.time.toMillis() <= data.endsAtMs;
    }

    // 1. Profil Pengguna
    match /users/{uid} {
      // Asisten hanya boleh mengambil profil praktikan satu per satu (nama/NIM
      // untuk rekap). Query seluruh users dilarang; pencarian email lewat
      // Cloud Function resolveStudentByEmail.
      allow get: if isSignedIn()
        && (request.auth.uid == uid
          || (isAssistant() && resource.data.role == 'student'));
      allow list: if false;

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && (
          request.resource.data.role == 'student'
          || (request.resource.data.role == 'assistant' && hasAssistantInvite())
        )
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && validNim(request.resource.data);

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && validNim(request.resource.data)
        && (
          request.resource.data.role == resource.data.role
          || (resource.data.role == 'student'
            && request.resource.data.role == 'assistant'
            && hasAssistantInvite())
        );

      allow delete: if false;
    }

    // Undangan asisten ditulis admin (Admin SDK); klien hanya cek statusnya.
    match /assistant_invites/{email} {
      allow read: if isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    match /users/{uid}/push_tokens/{installationId} {
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 200
        && request.resource.data.token.matches('^(Expo|Exponent)PushToken\\[[A-Za-z0-9_-]+\\]$')
        && request.resource.data.platform in ['android', 'ios']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Inbox notifikasi: hanya ditulis server (Admin SDK); pemilik hanya boleh
    // membaca dan menandai sudah dibaca.
    match /users/{uid}/notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt is string
        && request.resource.data.readAt.size() <= 40;
      allow create, delete: if false;
    }

    // 2. Kelas & Peserta
    match /classes/{classId} {
      allow read: if (isAssistant() && request.auth.uid in resource.data.assistantIds)
        || (isStudent() && request.auth.uid in resource.data.participantIds);

      allow create: if isAssistant()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.assistantIds
        && request.resource.data.courseName is string
        && request.resource.data.courseName.size() > 0
        && request.resource.data.groupName is string
        && request.resource.data.groupName.size() > 0;

      allow update: if isAssistant()
        && request.auth.uid in resource.data.assistantIds
        && request.auth.uid in request.resource.data.assistantIds
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isAssistant() && request.auth.uid in resource.data.assistantIds;
    }

    // 3. Jadwal & Sesi Praktikum
    match /sessions/{sessionId} {
      allow read: if (isAssistant() && request.auth.uid in resource.data.assistantIds)
        || (isStudent() && request.auth.uid in resource.data.participantIds);

      allow create: if isAssistant()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'scheduled'
        && request.resource.data.openedAt == null
        && request.resource.data.closedAt == null
        && request.resource.data.startsAt is string
        && request.resource.data.endsAt is string
        && request.resource.data.startsAtMs is int
        && request.resource.data.endsAtMs is int
        && request.resource.data.endsAtMs > request.resource.data.startsAtMs
        && request.auth.uid in request.resource.data.assistantIds;

      allow update: if isAssistant()
        && request.auth.uid in resource.data.assistantIds
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          (resource.data.status == request.resource.data.status
            && validSessionEdit())
          || validStatusPatch()
        );

      // Batalkan, jangan hapus: peserta sudah menerima notifikasi jadwal.
      allow delete: if false;
    }

    // 3b. Master Laboratorium (Sprint 3) — acuan geofence presensi & peta
    function validLab(data) {
      return data.name is string && data.name.size() > 0
        && data.building is string && data.building.size() > 0
        && data.location.latitude is number
        && data.location.latitude >= -90 && data.location.latitude <= 90
        && data.location.longitude is number
        && data.location.longitude >= -180 && data.location.longitude <= 180
        && data.radiusMeters is int
        && data.radiusMeters >= 10 && data.radiusMeters <= 500
        && data.isActive is bool;
    }

    match /labs/{labId} {
      allow read: if isSignedIn();

      allow create: if isAssistant()
        && request.resource.data.createdBy == request.auth.uid
        && validLab(request.resource.data);

      allow update: if isAssistant()
        && request.resource.data.createdBy == resource.data.createdBy
        && validLab(request.resource.data);

      allow delete: if isAssistant();
    }

    // 4. Presensi Terintegrasi (ID deterministik: {sessionId}_{studentId})
    // Tulisan presensi hanya lewat callable submitQrCheckIn (Admin SDK), yang
    // memverifikasi token QR berputar dan geofence. Klien tidak boleh menulis.
    match /attendance/{attendanceId} {
      // get dokumen milik sendiri boleh walau belum ada (cek duplikasi setelah permission-denied)
      allow get: if (isAssistant()
        && request.auth.uid
          in sessionData(resource.data.sessionId).assistantIds)
        || (isStudent() && attendanceId.matches('^.+_' + request.auth.uid + '$'));

      allow list: if (isAssistant()
        && exists(/databases/$(database)/documents/sessions/$(resource.data.sessionId))
        && request.auth.uid
          in sessionData(resource.data.sessionId).assistantIds)
        || (isStudent() && resource.data.studentId == request.auth.uid);

      allow create: if false;

      allow update, delete: if false;
    }

    // 5. Pengajuan Izin & Pemeriksaan Asisten
    match /leave_requests/{leaveId} {
      // Alasan izin bisa berisi data kesehatan: hanya asisten sesi terkait.
      allow get: if (isAssistant()
        && exists(/databases/$(database)/documents/sessions/$(resource.data.sessionId))
        && request.auth.uid
          in sessionData(resource.data.sessionId).assistantIds)
        || (isStudent() && resource.data.studentId == request.auth.uid);

      allow list: if (isAssistant()
        && exists(/databases/$(database)/documents/sessions/$(resource.data.sessionId))
        && request.auth.uid
          in sessionData(resource.data.sessionId).assistantIds)
        || (isStudent() && resource.data.studentId == request.auth.uid);

      // ID deterministik {sessionId}_{studentId} mencegah duplikat lintas perangkat.
      allow create: if isStudent()
        && leaveId == request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && validStudentNim(request.resource.data)
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
        && sessionData(request.resource.data.sessionId).status in ['scheduled', 'open']
        && withinLeaveWindow(sessionData(request.resource.data.sessionId))
        && request.auth.uid in sessionData(request.resource.data.sessionId).participantIds
        && !exists(/databases/$(database)/documents/attendance/$(leaveId));

      allow update: if isSignedIn() && (
        // Pengajuan ulang setelah ditolak oleh praktikan yang bersangkutan.
        (
          isStudent()
          && request.auth.uid == resource.data.studentId
          && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reason', 'aiPrediction', 'status', 'decisionNote', 'reviewedBy',
            'reviewedAt', 'createdAt', 'studentNim'
          ])
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reviewedBy == null
          && request.resource.data.reviewedAt == null
          && validStudentNim(request.resource.data)
          && sessionData(resource.data.sessionId).status in ['scheduled', 'open']
          && withinLeaveWindow(sessionData(resource.data.sessionId))
          && !exists(/databases/$(database)/documents/attendance/$(leaveId))
        ) || (
          // Keputusan asisten; izin tidak boleh disetujui bila presensi ada.
          isAssistant()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.reason == resource.data.reason
          && request.resource.data.aiPrediction == resource.data.aiPrediction
          && request.auth.uid in sessionData(resource.data.sessionId).assistantIds
          && (request.resource.data.status != 'approved'
            || !exists(/databases/$(database)/documents/attendance/$(leaveId)))
        )
      );

      allow delete: if false;
    }

    // 6. Tagihan Denda Keterlambatan (Sprint 4 - SRS-4.11)
    // Diterbitkan klien saat presensi terlambat, dibebaskan asisten saat izin approved.
    match /fines/{fineId} {
      allow read: if isAssistant()
        || (isStudent() && resource.data.studentId == request.auth.uid);

      allow create: if isSignedIn()
        && (request.auth.uid == request.resource.data.studentId || isAssistant())
        && request.resource.data.status in ['unpaid', 'waived']
        && request.resource.data.amount is int
        && request.resource.data.amount > 0;

      allow update: if isAssistant()
        && request.resource.data.status in ['unpaid', 'waived'];

      allow delete: if false;
    }

    // 7. Transaksi Pembayaran (Sprint 4, P4/backend only)
    match /payment_transactions/{orderId} {
      allow read: if isAssistant()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if false;
    }
  }
}
